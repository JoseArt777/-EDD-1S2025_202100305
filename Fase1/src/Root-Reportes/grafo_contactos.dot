graph GrafoContactos {
  label="Reporte de relación de usuarios con contactos (Grafos)";
  fontsize=16;
  fontname="Arial";
  rankdir=LR;
  ranksep=2.0;
  nodesep=0.8;
  node [fontsize=11, fontname="Arial"];
  edge [penwidth=1.5];

  // ========== USUARIOS (Izquierda) ==========
  {
    rank=same;
    node [shape=circle, style=filled, fillcolor=lightblue];

    user_1 [label="ID: 1\nUsuario: lgarcia"];
    user_2 [label="ID: 2\nUsuario: mitzep"];
    user_3 [label="ID: 3\nUsuario: gkroah-hartman"];
    user_4 [label="ID: 4\nUsuario: mshuttleworth"];
    user_5 [label="ID: 5\nUsuario: smejia"];
    user_6 [label="ID: 6\nUsuario: bfox"];
    user_7 [label="ID: 7\nUsuario: jcorbet"];
    user_8 [label="ID: 8\nUsuario: ksandler"];
    user_9 [label="ID: 9\nUsuario: mbaker"];
    user_10 [label="ID: 10\nUsuario: imurdock"];
    user_0 [label="ID: 0\nUsuario: root"];
    user_11 [label="ID: 11\nUsuario: ltorvalds"];
    user_12 [label="ID: 12\nUsuario: rstallman"];
  }

  // ========== CONTACTOS (Derecha) ==========
  {
    rank=same;
    node [shape=circle, style=filled, fillcolor=lightgreen];

  }

  // ========== RELACIONES ==========

}
