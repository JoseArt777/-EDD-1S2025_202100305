    Color := clSkyBlue;
  end;

  BtnCerrar := TButton.Create(Panel);
  with BtnCerrar do
  begin
    Parent := Panel;
    Caption := 'Cerrar';
    Left := 620;
    Top := 445;
    Width := 150;
    Height := 35;
    OnClick := @Logueo_OnCerrarClick;
    Cancel := True;
  end;

  // Cargar datos iniciales
  Logueo_RellenarLista;

  FFormLogueo.Show;
end;

