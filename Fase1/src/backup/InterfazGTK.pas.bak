      Parent := PanelContacto;
      Caption := 'Cancelar';
      Left := 210;
      Top := 130;
      Width := 80;
      Height := 30;
      ModalResult := mrCancel;
      Cancel := True;
    end;

    ModalResult := FormAgregarContacto.ShowModal;

    if ModalResult = mrOk then
    begin
