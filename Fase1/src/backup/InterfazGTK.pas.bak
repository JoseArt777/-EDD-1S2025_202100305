    Parent := Panel;
    Caption := 'Total: 0';
    Left := 200;
    Top := 14;
    Font.Color := clGray;
  end;

  // Lista de favoritos
  FListFavoritos := TListBox.Create(Panel);
  with FListFavoritos do
