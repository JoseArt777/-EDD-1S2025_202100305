  Width := 150;
  Height := 30;
  OnClick := @Papelera_OnVaciarClick;
  Color := clRed;
  Font.Color := clWhite;
  Font.Style := [fsBold];
end;

  BtnCerrar := TButton.Create(Panel);
  with BtnCerrar do
  begin
    Parent := Panel;
    Caption := 'Cerrar';
    Left := 550; Top := 410; Width := 120; Height := 30;
          OnClick := @Papelera_OnCerrarClick;



